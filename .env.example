# ---------------------------------------------------------------------------
# Reservation email (server-side only — never prefixed with VITE_)
# Used by `npm run server` (server/index.ts) and the Vercel function (api/).
# Copy to `.env` locally; set the same keys in your host's environment.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465); STARTTLS on 587 works with "false"
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on outgoing mail and the café inbox that receives requests
MAIL_FROM="Ember & Oak <reservations@example.com>"
MAIL_TO=hello@example.com
# Also send the guest an acknowledgement copy
MAIL_GUEST_COPY=true
# Log the email instead of sending it (handy while developing)
MAIL_DRY_RUN=false

# Optional: name used in email templates
CAFE_NAME="Ember & Oak"
# Optional: port for `npm run server` (default 8790)
PORT=8790
# Optional: allow a different frontend origin to call this API (CORS)
ALLOWED_ORIGIN=

# ---------------------------------------------------------------------------
# Frontend (Vite, baked into the bundle at build time)
# ---------------------------------------------------------------------------
# Only needed when the API lives on another origin. Defaults to /api/reserve.
VITE_RESERVATION_ENDPOINT=
