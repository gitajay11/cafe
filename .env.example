# Reservation email (server-side only). Copy to `.env` locally; set the same
# keys in your host's environment (e.g. the Vercel project settings).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender shown on outgoing mail (Gmail requires this to match SMTP_USER)
MAIL_FROM="Ember & Oak <reservations@example.com>"
# Inbox that receives reservation requests
MAIL_TO=hello@example.com
# Also send the guest an acknowledgement copy
MAIL_GUEST_COPY=true
